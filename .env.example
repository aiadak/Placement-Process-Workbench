# Copy to .env.local for local dev (vercel dev), or set these in Vercel project settings.
# Never commit real values.

# Required for live AI extraction in the Quote Lab
OPENAI_API_KEY=sk-your-NEW-key-here

# Optional - turns on the password gate. If unset, the app is open (no gate).
APP_PASSWORD=choose-a-strong-passphrase

# Optional - defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
